root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,cs}]
indent_style = space
indent_size = 4
end_of_line = lf

[*.js]
indent_style = space
indent_size = 2
end_of_line = lf

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.md]
end_of_line = lf
trim_trailing_whitespace = false
